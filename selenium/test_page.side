{
  "id": "7cf51140-f5a2-4e79-9d3f-e37b7188b5e0",
  "version": "2.0",
  "name": "Devops-tests",
  "url": "http://129.159.141.184:8080",
  "tests": [{
    "id": "5693aa76-5299-4eca-9ce8-c47fb8d9cdc6",
    "name": "test_page",
    "commands": [{
      "id": "6c5633ea-cbf8-48c8-ac84-149d36f4dd40",
      "comment": "",
      "command": "open",
      "target": "/test/index.jsp",
      "targets": [],
      "value": ""
    }, {
      "id": "f7635248-729b-4dd5-b28a-c3289fbb2e45",
      "comment": "",
      "command": "assertText",
      "target": "css=span:nth-child(1)",
      "targets": [
        ["css=span:nth-child(1)", "css:finder"],
        ["xpath=//h1/span", "xpath:position"],
        ["xpath=//span[contains(.,'DevOps Project')]", "xpath:innerText"]
      ],
      "value": "DevOps Project"
    }, {
      "id": "8a068226-7150-4ff6-a439-31387d46cc46",
      "comment": "",
      "command": "type",
      "target": "name=data",
      "targets": [
        ["name=data", "name"],
        ["css=.input", "css:finder"],
        ["xpath=//input[@name='data']", "xpath:attributes"],
        ["xpath=//input", "xpath:position"]
      ],
      "value": "DevOpsProject"
    }, {
      "id": "34d8d41a-ba4e-40bb-a26d-71393ac8a745",
      "comment": "",
      "command": "assertValue",
      "target": "name=data",
      "targets": [],
      "value": "DevOpsProject"
    }, {
      "id": "85763b8a-b662-42e6-9f0d-92eeea0eeb20",
      "comment": "",
      "command": "click",
      "target": "css=.btn",
      "targets": [
        ["css=.btn", "css:finder"],
        ["xpath=//button[@type='submit']", "xpath:attributes"],
        ["xpath=//button", "xpath:position"],
        ["xpath=//button[contains(.,'Submit Data')]", "xpath:innerText"]
      ],
      "value": ""
    }, {
      "id": "0f0d56be-db77-406c-a52f-5f0064e2143e",
      "comment": "",
      "command": "assertText",
      "target": "css=.result",
      "targets": [
        ["css=.result", "css:finder"],
        ["xpath=//div[3]/div[2]", "xpath:position"]
      ],
      "value": "You entered: DevOpsProject"
    }, {
      "id": "4ceb0397-565f-4672-b7d0-15097c2677d9",
      "comment": "",
      "command": "assertText",
      "target": "css=.subtitle",
      "targets": [
        ["css=.subtitle", "css:finder"],
        ["xpath=//div[4]/div", "xpath:position"]
      ],
      "value": "Welcome to our JSP Application"
    }]
  }],
  "suites": [{
    "id": "0e68df56-7fcb-4716-ba84-7f8008ebad59",
    "name": "Default Suite",
    "persistSession": false,
    "parallel": false,
    "timeout": 300,
    "tests": []
  }],
